    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-import": "^2.32.0",
    "knip": "^6.34.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
