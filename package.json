    "check:entity-zones": "node scripts/gen-entity-zones.mjs --check",
    "check:entity-imports": "node scripts/check-entity-imports.mjs",
    "check:table-ownership": "node scripts/check-table-ownership.mjs",
    "postbuild": "node scripts/check-tracing-includes.mjs",
    "gen:types": "node scripts/gen-supabase-types.mjs",
    "check:types-fresh": "node scripts/gen-supabase-types.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run check:action-auth && npm run check:migrations && npm run check:file-sizes && npm run check:lint-warnings && npm run check:design-ratchet && npm run check:entity-zones && npm run check:entity-imports && npm run check:table-ownership && npm run check:tracing -- --if-built && npm test"
  },
  "dependencies": {
