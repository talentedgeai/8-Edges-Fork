{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Next.js routes, layouts, opengraph images etc. are found by knip's Next plugin.
  // One-off scripts are ENTRY files rather than ignored: an ignored file's imports
  // would not count, and several lib/ modules (lib/family-screen.ts, lib/role-families.ts)
  // are used only from scripts/. As entries their imports keep lib/ exports alive while
  // their own exports are not reported.
  "entry": ["scripts/**/*.{ts,mjs}", ".github/scripts/**/*.mjs"],
  "project": ["**/*.{ts,tsx,js,mjs}"],
  "ignore": [
    // Standalone video-rendering project with its own toolchain; excluded from tsconfig too.
    "video/**",
    // Files rsync'd over the public 8-Edges-Fork by the fork-sync workflow; nothing in
    // this repo imports them by design.
    ".github/fork-overlay/**",
    // Deno edge functions, deployed by the Supabase CLI; not part of the Node graph.
    "supabase/functions/**",
    // CommonJS module consumed by the opengraph-image routes through named imports;
    // knip reads its module.exports as an unused default export and ignores @public
    // tags on CJS, so the file is skipped rather than rewritten as ESM.
    "lib/ogRender.js",
    // Generated by `npm run gen:types` (AR-01). It exports every helper the Supabase
    // CLI emits (Tables, Enums, Constants, ...) whether or not the app uses them yet,
    // and trimming the output would break the byte-for-byte freshness check.
    "kernel/data/supabase/database.types.ts"
  ],
  // scripts/calls/sync-lark-minutes.mjs shells out to the Lark CLI, installed per machine;
  // scripts/gen-supabase-types.mjs shells out to the Supabase CLI (brew locally,
  // supabase/setup-cli in the types-fresh CI job). Neither is an npm dependency.
  "ignoreBinaries": ["lark-cli", "supabase"],
  "ignoreExportsUsedInFile": true
}
